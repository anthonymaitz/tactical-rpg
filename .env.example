# Postgres connection (server only — Bun auto-loads this file from the repo
# root; server/.env is a symlink to it since Bun only reads .env from cwd)
DATABASE_URL=postgres://postgres:your-password@localhost:5432/tactical_rpg

# Secret used to sign/verify the app's own JWTs (server only). Generate with:
# openssl rand -base64 32
AUTH_JWT_SECRET=your-random-secret

# HTTP API base URL (Hono server)
VITE_API_URL=http://localhost:3000

# Colyseus WebSocket server URL
VITE_SERVER_URL=ws://localhost:2567
